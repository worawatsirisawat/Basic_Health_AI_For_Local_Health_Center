# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ถ้าไม่มีไฟล์ .env ระบบจะทำงานใน Mock mode อัตโนมัติและรันได้ตามปกติ

# ── Typhoon LLM ──────────────────────────────────────────────
# ขอ API key ได้ที่ https://opentyphoon.ai
# ถ้าเว้นว่างไว้ ระบบจะใช้ Mock mode ที่มีชุดกฎสาธิตในตัว
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_LLM_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_TIMEOUT=60

# ── PubMed / NCBI E-utilities ────────────────────────────────
# ไม่มี API key ก็ใช้งานได้ แต่จำกัดที่ 3 คำขอต่อวินาที
# ถ้ามี key จะเพิ่มเป็น 10 คำขอต่อวินาที ขอได้ฟรีจากบัญชี NCBI
PUBMED_API_KEY=
PUBMED_EMAIL=
PUBMED_ENABLED=true
PUBMED_MAX_RESULTS=3
PUBMED_TIMEOUT=12
PUBMED_CACHE_TTL=86400

# ── ตรรกะการซักประวัติ ───────────────────────────────────────
MIN_QUESTIONS=3
MAX_QUESTIONS=5
